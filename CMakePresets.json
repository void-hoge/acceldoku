{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "dev", "inherits": "base",
      "displayName": "CPU reference and RTL simulation",
      "cacheVariables": { "ACCELDOKU_PROFILE": "dev", "BUILD_TESTING": "ON" }
    },
    {
      "name": "kv260-ps", "inherits": "base",
      "displayName": "KV260 software and kernel module (native build)",
      "cacheVariables": { "ACCELDOKU_PROFILE": "kv260-ps", "BUILD_TESTING": "ON" }
    },
    {
      "name": "kv260-pl", "inherits": "base",
      "displayName": "KV260 FPGA implementation and firmware",
      "cacheVariables": { "ACCELDOKU_PROFILE": "kv260-pl" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "kv260-pl", "configurePreset": "kv260-pl" },
    { "name": "kv260-ps", "configurePreset": "kv260-ps" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "kv260-ps", "configurePreset": "kv260-ps", "output": { "outputOnFailure": true } }
  ]
}
